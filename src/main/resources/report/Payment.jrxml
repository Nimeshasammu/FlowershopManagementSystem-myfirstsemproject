	<query language="SQL"><![CDATA[ SELECT p.payment_id,
                   p.order_id,
                   p.payment_method,
                   p.total_amount,
                   p.payment_date,
                   o.cus_id,
                   p.status
            FROM Payment p
            JOIN Orders o ON p.order_id = o.order_id]]></query>
